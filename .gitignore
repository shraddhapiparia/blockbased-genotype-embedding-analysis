# Data and generated outputs (access-controlled or reproducible)
results/
data/*
geno_ld/
metadata/

# Un-ignore the synthetic smoke-test generator (script only, not generated files).
# data/* is used (not data/) so git can traverse into data/synthetic/ for exceptions.
data/
!data/synthetic/
data/synthetic/region_blocks/
data/synthetic/block_plan/
data/synthetic/*
!data/synthetic/create_synthetic_data.py

# OS / editor junk
.DS_Store
**/.DS_Store

# Python bytecache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Archive scratch (archived .py source files remain tracked)
scripts/archive/__pycache__/
scripts/archive/*.pyc
scripts/archive/tmp/
scripts/archive/.DS_Store

# Environments and packaging
*.egg-info/
dist/
build/
.env
.venv/

# Jupyter checkpoints
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
